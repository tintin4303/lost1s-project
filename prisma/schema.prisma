// Lost1s Pet Shelter Management System
// Database Schema for Adopters, Staff, and Donors
// Simplified schema without enums for cleaner ERD presentation

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Pet {
  id           String        @id @default(cuid())
  name         String
  species      String        // e.g., "DOG", "CAT", "BIRD", "RABBIT", "OTHER"
  breed        String?
  age          Int           // Age in years
  vaccinated   Boolean       @default(false)
  spayed       Boolean       @default(false)
  status       String        @default("AVAILABLE") // e.g., "AVAILABLE", "ADOPTED", "PENDING"
  intakeDate   DateTime      @default(now())
  imageUrl     String?
  description  String?
  applications Application[]
  schedules    Schedule[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([species])
  @@index([status])
}

model User {
  id            String        @id @default(cuid())
  name          String
  email         String        @unique
  password      String
  role          String        @default("ADOPTER") // Primary Role (ADOPTER, STAFF)
  additionalRole String?      // Optional Additional Role (e.g. DONOR)
  isBlacklisted Boolean       @default(false)
  applications  Application[]
  schedules     Schedule[]
  donations     Donation[]
  securityLogs  SecurityLog[] // Logs ABOUT this user
  bannedBy      Admin?        @relation("AdminBan", fields: [bannedById], references: [id])
  bannedById    String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([email])
  @@index([role])
}

model Application {
  id           String        @id @default(cuid())
  pet          Pet           @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId        String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  reason       String        // Why they want to adopt
  experience   String        // Pet experience
  housingType  String        // e.g., "HOUSE", "APARTMENT", "CONDO", "OTHER"
  hasYard      Boolean       // Has a yard
  status       String        @default("REVIEW") // e.g., "REVIEW", "APPROVED", "REJECTED"
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([petId])
  @@index([userId])
  @@index([status])
}

// Replaces Appointment
model Schedule {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  pet       Pet      @relation(fields: [petId], references: [id], onDelete: Cascade)
  petId     String
  date      DateTime
  timeSlot  String   // e.g., "10:00 AM", "2:00 PM"
  location  String   // e.g., "Shelter Main Hall"
  notes     String?  // Optional notes from adopter
  status    String   @default("PENDING") // PENDING, CONFIRMED, COMPLETED, CANCELLED, REJECTED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, timeSlot, location]) // Prevent double booking same slot/location
  @@index([userId])
  @@index([petId])
  @@index([status])
}

model Donation {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  amount    Float
  type      String   // e.g., "FOOD", "MEDICAL", "GENERAL"
  frequency String   // e.g., "ONE_TIME", "WEEKLY", "MONTHLY"
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model SecurityLog {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  incident  String
  action    String
  status      String   @default("OPEN") // OPEN, REVIEWING, RESOLVED
  resolvedAt  DateTime?
  resolver    Admin?    @relation("SecurityResolver", fields: [resolverId], references: [id]) // RELINKED TO ADMIN
  resolverId  String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@index([status])
}

// NEW ADMIN ENTITY
model Admin {
  id           String        @id @default(cuid())
  username     String        @unique
  password     String
  resolvedLogs SecurityLog[] @relation("SecurityResolver")
  bannedUsers  User[]        @relation("AdminBan")
  createdAt    DateTime      @default(now())
}
